# Copy to msk.env and fill after MSK cluster creation.
# Source before running create-topics.sh:  set -a && source deploy/phase0/msk/msk.env && set +a

AWS_REGION=ap-south-1
MSK_CLUSTER_NAME=identity-bridge-msk

# Plaintext / TLS / SASL_SSL bootstrap brokers (from AWS console or CLI)
MSK_BOOTSTRAP_BROKERS=b-1.identity-bridge-msk.xxxx.kafka.ap-south-1.amazonaws.com:9096,b-2...

# SCRAM auth (recommended for ingest phase)
MSK_SCRAM_USERNAME=identity-bridge-ingest
# MSK_SCRAM_PASSWORD=set-in-secrets-manager-not-in-git

# Topic names (must match Kafka_Tier.md)
TOPIC_EVENTS=identity-events
TOPIC_CATALOG=identity-catalog
TOPIC_HEARTBEAT=identity-heartbeat

# Target: 50,000 ingest requests/sec
TOPIC_EVENTS_PARTITIONS=24
TOPIC_CATALOG_PARTITIONS=8
TOPIC_HEARTBEAT_PARTITIONS=4
TOPIC_REPLICATION_FACTOR=3
