# Copy to secret.yaml and fill values, or use kubectl create secret (see README).
# Do not commit secret.yaml with real credentials.
apiVersion: v1
kind: Secret
metadata:
  name: server-ingest-secrets
  namespace: identity-bridge
  labels:
    app: server-ingest
    tier: ingestion
type: Opaque
stringData:
  msk_scram_username: identity-bridge-ingest
  msk_scram_password: REPLACE_ME
  collector_api_keys: ""
